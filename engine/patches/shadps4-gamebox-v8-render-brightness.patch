+#include <cstdlib>
 #include <span>
 #include <unordered_map>
 
@@ -29,6 +30,54 @@ public:
     /// Returns a formatted string for the driver version
     std::string GetDriverVersionName();
 
+    // GameBox v7: canonical format feature sets used by the texture cache when
+    // it creates images (see image.cpp ImageUsageFlags / FormatFeatureFlags).
+    // Pipelines must resolve their declared attachment formats with the same
+    // sets so the pipeline format and the actual image format can never
+    // disagree — a mismatch silently breaks depth testing on drivers with
+    // partial format support (e.g. D16S8 on Maxwell).
+    static constexpr vk::FormatFeatureFlags2 kDepthImageFeatures =
+        vk::FormatFeatureFlagBits2::eDepthStencilAttachment |
+        vk::FormatFeatureFlagBits2::eSampledImage |
+        vk::FormatFeatureFlagBits2::eTransferSrc | vk::FormatFeatureFlagBits2::eTransferDst;
+    static constexpr vk::FormatFeatureFlags2 kColorImageFeatures =
+        vk::FormatFeatureFlagBits2::eColorAttachment |
+        vk::FormatFeatureFlagBits2::eSampledImage |
+        vk::FormatFeatureFlagBits2::eTransferSrc | vk::FormatFeatureFlagBits2::eTransferDst;
+
+    // GameBox v8: frame-attachment encoding selector, declared here (in-class
+    // inline) so vk_presenter.cpp sees it before first use — this is the fix
+    // for the v7.0/v7.1 declaration-order build failures. v7 forced the sRGB
+    // sibling of the swapchain format on every SDR chain; on Maxwell-class
+    // drivers the guest already delivers display-encoded pixels, so the extra
+    // hardware encode washed the image out (bright, grey mids — user-verified
+    // regression). v8 restores the stock identity chain by default and lets
+    // the front end opt back into the sRGB encode per launch via
+    // GAMEBOX_OUTPUT_SRGB=1, so both encodings coexist behind one build and
+    // users can A/B them without reflashing the engine.
+    [[nodiscard]] static vk::Format GetFrameAttachmentFormat(
+        const vk::Format swapchain_format, const bool is_hdr) {
+        if (is_hdr) {
+            return swapchain_format;
+        }
+        static const bool srgb_out = [] {
+            // Global namespace getenv: declared via <cstdlib>, which every
+            // standard header chain pulls in; avoids assuming <cstdlib> here.
+            const char* env = ::getenv("GAMEBOX_OUTPUT_SRGB");
+            return env != nullptr && env[0] == '1';
+        }();
+        if (!srgb_out) {
+            return swapchain_format;
+        }
+        if (swapchain_format == vk::Format::eR8G8B8A8Unorm) {
+            return vk::Format::eR8G8B8A8Srgb;
+        }
+        if (swapchain_format == vk::Format::eB8G8R8A8Unorm) {
+            return vk::Format::eB8G8R8A8Srgb;
+        }
+        return swapchain_format;
+    }
+
     /// Gets a compatibility format if the format is not supported.
     [[nodiscard]] vk::Format GetSupportedFormat(vk::Format format,
                                                 vk::FormatFeatureFlags2 flags) const;
